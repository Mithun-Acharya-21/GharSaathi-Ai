# Application
APP_NAME="GharSaathi Maths API"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gharsaathi

# Gnani Prisma (Speech-to-Text)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_LANGUAGE_DEFAULT=kn-IN
GNANI_STT_FORMAT=verbatim
GNANI_STT_TIMEOUT_SECONDS=30

# Gnani Timbre (Text-to-Speech)
GNANI_TTS_ENABLED=false
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE_DEFAULT=kn-IN
GNANI_TTS_VOICE_KN=Saanvi
GNANI_TTS_VOICE_EN=Kaveri
GNANI_TTS_TIMEOUT_SECONDS=30

# Security & Teacher Access
TEACHER_API_KEY=dev-teacher-secret-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Constraints & Safeguards
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=60
MAX_TRANSCRIPT_LENGTH=2000
MAX_TRANSCRIPTIONS_PER_SESSION=10
SESSION_TOKEN_TTL_HOURS=24
DATA_RETENTION_DAYS=30


